# =============================================================================
# outreach/.env.example  -  copy to .env and fill in. .env is git-ignored.
# The Gmail credentials live ONLY in Himalaya's own config, never here.
# =============================================================================

# --- Search providers (need at least one) ----------------------------------
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# --- Fallback LLM providers (OpenAI-compatible) ----------------------------
GOOGLE_AI_STUDIO_API_KEY=
OPENCODE_ZEN_API_KEY=
OPENROUTER_API_KEY=

# --- Optional email verification API (e.g. ZeroBounce/Hunter-style) --------
EMAIL_VERIFY_API_KEY=
EMAIL_VERIFY_BASE_URL=
